使用示例
 
{lstlisting[language=Python, caption=快速开始示例]
from bin_packing_solver import solve_3d_bpp
from visualization import visualize_3d_packing
 
# 定义容器和箱子
container_dims = (50, 50, 50)
box_types = [
{"type_id": "A", "l": 20, "w": 10, "h": 5, "quantity": 2,
{"type_id": "B", "l": 15, "w": 15, "h": 10, "quantity": 3,
]
 
# 求解
status, results_df, solver_response = solve_3d_bpp(
container_dims=container_dims,
box_types=box_types,
time_limit_seconds=60,
maximize_volume=False
)
 
# 可视化结果
if results_df is not None:
result = results_df.to_dict('records')
total_volume = solver_response['total_volume']
visualize_3d_packing(result, container_dims, total_volume, box_types)
