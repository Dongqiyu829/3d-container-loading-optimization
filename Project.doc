#!/bin/bash
# 3D装箱项目环境配置脚本
 
echo "开始配置3D装箱项目环境..."
 
# 检查conda是否安装
if ! command -v conda &> /dev/null; then
echo "错误：未检测到conda，请先安装Anaconda"
exit 1
fi
 
# 配置conda镜像源
echo "配置conda镜像源..."
conda config --add channels  Index of /anaconda/pkgs/main/ | 清华大学开源软件镜像站 | Tsinghua Open Source Mirror
