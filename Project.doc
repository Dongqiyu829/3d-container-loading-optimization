conda config --add channels Error
conda config --set show_channel_urls yes
 
# 创建虚拟环境
echo "创建虚拟环境..."
conda create -n bin_packing python=3.9 -y
 
# 激活环境
echo "激活环境..."
source activate bin_packing
 
# 安装依赖包
echo "安装依赖包..."
pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple/
 
# 配置Jupyter
echo "配置Jupyter..."
python -m ipykernel install --user --name bin_packing --display-name "3D装箱环境"
 
