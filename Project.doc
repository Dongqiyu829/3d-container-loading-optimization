快速验证安装：
 
{lstlisting[language=python, caption=快速功能验证]
# 在Python中运行以下代码验证核心功能
from ortools.sat.python import cp_model
import pandas as pd
import matplotlib.pyplot as plt
 
# 创建简单测试用例
model = cp_model.CpModel()
x = model.NewIntVar(0, 10, 'x')
y = model.NewIntVar(0, 10, 'y')
model.Add(x + y >= 5)
model.Maximize(x + y)
 
solver = cp_model.CpSolver()
status = solver.Solve(model)
 
if status == cp_model.OPTIMAL:
print("✅ OR-Tools CP-SAT工作正常！")
print(f"最优解: x={solver.Value(x), y={solver.Value(y)")
else:
print("❌ OR-Tools配置有问题")
 
# 验证可视化功能
fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')
ax.bar3d([0], [0], [0], [1], [1], [1])
print("✅ 3D可视化功能正常！")
plt.close()
 
print("�� 所有核心功能验证通过，环境配置成功！")
