{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/3d-container-loading/benchmark_summary.schema.json",
  "title": "Container-loading benchmark run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_format_version",
    "benchmark_run_id",
    "timestamp",
    "suite_name",
    "suite_version",
    "suite_path",
    "git_commit_hash",
    "git_dirty",
    "source_state_sha256",
    "configuration",
    "records"
  ],
  "properties": {
    "benchmark_format_version": { "const": "1.0" },
    "benchmark_run_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "suite_name": { "type": "string", "minLength": 1 },
    "suite_version": { "type": "string", "minLength": 1 },
    "suite_path": { "type": "string", "minLength": 1 },
    "git_commit_hash": { "type": ["string", "null"] },
    "git_dirty": { "type": ["boolean", "null"] },
    "source_state_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration": { "type": "object" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableString": { "type": ["string", "null"] },
    "result": {
      "type": "object",
      "required": [
        "benchmark_run_id",
        "timestamp",
        "instance_id",
        "difficulty",
        "solver",
        "status",
        "candidate_box_count",
        "packed_box_count",
        "packed_volume",
        "utilization",
        "container_empty_fraction",
        "end_to_end_runtime_seconds",
        "solver_core_runtime_seconds",
        "time_limit_seconds",
        "validation",
        "validation_issue_count",
        "objective_type",
        "objective_value",
        "raw_solver_best_bound",
        "raw_solver_absolute_gap",
        "raw_solver_relative_gap",
        "physical_volume_upper_bound",
        "effective_upper_bound",
        "effective_absolute_gap",
        "effective_incumbent_normalized_gap",
        "worker_count",
        "random_seed",
        "python_version",
        "python_executable",
        "platform",
        "git_commit_hash",
        "git_dirty",
        "source_state_sha256",
        "ortools_version",
        "runner_exit_code",
        "solution_path",
        "metadata_path"
      ],
      "properties": {
        "benchmark_run_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "instance_id": { "type": "string" },
        "difficulty": { "type": "string" },
        "solver": { "enum": ["greedy", "cpsat"] },
        "status": { "type": "string" },
        "candidate_box_count": { "type": "integer", "minimum": 1 },
        "packed_box_count": { "$ref": "#/$defs/nullableInteger" },
        "packed_volume": { "$ref": "#/$defs/nullableInteger" },
        "utilization": { "$ref": "#/$defs/nullableNumber" },
        "container_empty_fraction": { "$ref": "#/$defs/nullableNumber" },
        "end_to_end_runtime_seconds": { "type": "number", "minimum": 0 },
        "solver_core_runtime_seconds": { "$ref": "#/$defs/nullableNumber" },
        "time_limit_seconds": { "$ref": "#/$defs/nullableNumber" },
        "validation": { "enum": ["VALID", "NOT_PERFORMED"] },
        "validation_issue_count": { "$ref": "#/$defs/nullableInteger" },
        "objective_type": { "type": "string" },
        "objective_value": { "$ref": "#/$defs/nullableNumber" },
        "raw_solver_best_bound": { "$ref": "#/$defs/nullableNumber" },
        "raw_solver_absolute_gap": { "$ref": "#/$defs/nullableNumber" },
        "raw_solver_relative_gap": { "$ref": "#/$defs/nullableNumber" },
        "physical_volume_upper_bound": { "$ref": "#/$defs/nullableNumber" },
        "effective_upper_bound": { "$ref": "#/$defs/nullableNumber" },
        "effective_absolute_gap": { "$ref": "#/$defs/nullableNumber" },
        "effective_incumbent_normalized_gap": { "$ref": "#/$defs/nullableNumber" },
        "worker_count": { "$ref": "#/$defs/nullableInteger" },
        "random_seed": { "$ref": "#/$defs/nullableInteger" },
        "python_version": { "$ref": "#/$defs/nullableString" },
        "python_executable": { "$ref": "#/$defs/nullableString" },
        "platform": { "$ref": "#/$defs/nullableString" },
        "git_commit_hash": { "$ref": "#/$defs/nullableString" },
        "git_dirty": { "type": ["boolean", "null"] },
        "source_state_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "ortools_version": { "$ref": "#/$defs/nullableString" },
        "runner_exit_code": { "$ref": "#/$defs/nullableInteger" },
        "solution_path": { "$ref": "#/$defs/nullableString" },
        "metadata_path": { "type": "string" }
      }
    }
  }
}
